# Copy to .env and fill in. Every key this app reads is listed here.
# Every setting currently has a default; required secrets (Teams, GitHub)
# will fail fast at startup, naming every missing key, when they land.

# --- Core ---------------------------------------------------------------
STANDUP_ENV=local
STANDUP_DATABASE_URL=sqlite:///./standup.db
STANDUP_BASE_URL=http://localhost:8000
STANDUP_LOG_LEVEL=INFO
STANDUP_LOG_JSON=false

# --- Digest behaviour ---------------------------------------------------
STANDUP_SUMMARIZER=rules
STANDUP_VALIDATOR_STRICT=false
STANDUP_RETENTION_DAYS=30

# --- Week 2: Microsoft Teams (unused until the Teams adapter lands) ------
# Hierarchical env-var shape required by the M365 Agents SDK.
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=True

# --- Week 3: GitHub tracker (unused until the tracker lands) -------------
# STANDUP_GITHUB_TOKEN=
# STANDUP_GITHUB_REPO=owner/repo
# STANDUP_TRACKER_AUTOCLOSE=false
