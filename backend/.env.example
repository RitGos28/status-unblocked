# Every key this app reads is listed here, filled with DEMO values.
#
# Fallback: with no backend/.env, the app and every script (alembic, seed_demo,
# tick, ...) take any variable you have not set from this file, so a fresh
# checkout runs the accountless demo (docs/DEMO.md) with nothing to configure.
# The fallback only applies when STANDUP_ENV is local or test, and only fills
# gaps: a variable you export always wins. STANDUP_ENV_EXAMPLE_FALLBACK=false
# turns it off.
#
# For anything real: cp .env.example .env, then replace every demo value.
# config.py fails fast at startup and names every missing required key at once.

# --- Core ---------------------------------------------------------------
STANDUP_ENV=local
STANDUP_DATABASE_URL=sqlite:///./standup.db
# An absolute http(s) URL (checked at startup). Leave empty to build evidence
# links from the address each request arrives on; the scheduler needs it set,
# because its links go into GitHub issues and Teams notices.
STANDUP_BASE_URL=http://127.0.0.1:8000
STANDUP_LOG_LEVEL=INFO
STANDUP_LOG_JSON=false
# Set false to stop this file filling in unset variables.
STANDUP_ENV_EXAMPLE_FALLBACK=true

# --- Sign-in -------------------------------------------------------------
# Sign-in is a team code plus a name (python -m scripts.team_codes prints the
# codes). At least 32 characters: signs the session cookie and Teams link
# codes; rotating it signs everyone out. This demo key is public, so the app
# refuses it unless STANDUP_ENV is local or test. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STANDUP_SECRET_KEY=demo-only-signing-key-published-in-env-example-never-deploy
# The manager portal's sign-in. These demo values are public (README lists
# them): set your own anywhere other people can reach.
STANDUP_MANAGER_USERNAME=manager
STANDUP_MANAGER_PASSWORD=status2026
# How long a sign-in lasts.
STANDUP_SESSION_DAYS=30
# Set true when served over HTTPS.
STANDUP_COOKIE_SECURE=false

# --- Digest behaviour ---------------------------------------------------
STANDUP_SUMMARIZER=rules
STANDUP_VALIDATOR_STRICT=false
# Retention is per team (team.retention_days, default 30 days), applied by the scheduler.

# --- Microsoft Teams bot (POST /api/messages) ----------------------------
# When true, the CLIENTID/CLIENTSECRET/TENANTID keys below become required,
# unless ANONYMOUS_ALLOWED=True (Agents Playground and the local fake
# connector only; refused unless STANDUP_ENV is local or test).
# Demo: on, anonymous; replies go to scripts/fake_teams_connector.py.
STANDUP_TEAMS_ENABLED=true
# Hierarchical env-var shape required by the M365 Agents SDK.
# For a real tenant, set these three and remove ANONYMOUS_ALLOWED.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=True

# --- Daily digest scheduler ----------------------------------------------
# Builds each team's digest at its cutoff, sends Teams "digest ready" notices,
# and drains the GitHub outbox. With true, STANDUP_BASE_URL becomes required.
# Demo: off; run one pass on demand with python -m scripts.tick.
STANDUP_SCHEDULER=false
STANDUP_SCHEDULER_INTERVAL_SECONDS=60

# --- GitHub Issues write-back for blockers ----------------------------------
# noop | github. With github, STANDUP_GITHUB_TOKEN becomes required: a
# fine-grained token with Issues read/write on the target repository only.
# Each team's repository is set with: python -m scripts.set_github_repo
# Demo: github, pointed at scripts/fake_github.py on port 8091 with a dummy
# token. For a real repo: https://api.github.com and a real token.
STANDUP_TRACKER=github
STANDUP_GITHUB_API_URL=http://127.0.0.1:8091
STANDUP_GITHUB_TOKEN=demo-token
# Optional, for the read-only live test (pytest -m live_github):
STANDUP_LIVE_GITHUB_TOKEN=
STANDUP_LIVE_GITHUB_REPO=
